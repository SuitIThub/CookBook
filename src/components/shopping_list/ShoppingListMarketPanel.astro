---
import { db } from '../../lib/database.server';
import type { Supermarket, Product } from '../../types/tracker';

interface Props {
  listId: string;
  initialSupermarketId?: string | null;
}

const { listId, initialSupermarketId } = Astro.props;

let supermarkets: Supermarket[] = [];
let products: Product[] = [];
try {
  supermarkets = db.getAllSupermarkets();
  products = db.getAllProducts();
} catch (err) {
  console.error('ShoppingListMarketPanel: failed to load supermarkets/products', err);
}

const productLookup: Record<string, Product> = {};
for (const p of products) productLookup[p.id] = p;
---

<section
  id="shopping-market-panel"
  class="card mt-6"
  data-list-id={listId}
  data-initial-supermarket={initialSupermarketId ?? ''}
>
  <div class="card-content space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
      <div class="flex-1">
        <label for="shopping-market-select" class="text-sm font-medium text-gray-700 dark:text-gray-300">
          Supermarkt für Preisschätzung
        </label>
        <div class="text-xs text-muted mt-0.5">
          Preise basieren auf Produktzuordnungen (Standardprodukt der Zutat oder explizite Wahl).
        </div>
      </div>
      <div class="flex items-center gap-2">
        <select
          id="shopping-market-select"
          class="form-input form-input-sm"
        >
          <option value="">Kein Markt</option>
          {supermarkets.map(m => (
            <option value={m.id} selected={m.id === initialSupermarketId}>{m.name}</option>
          ))}
        </select>
        <a href="/produkte" class="btn btn-ghost btn-sm text-muted" title="Produkte & Supermärkte verwalten">Verwalten</a>
      </div>
    </div>

    <div
      id="shopping-market-summary"
      class="text-sm text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700 rounded-md p-3 bg-gray-50 dark:bg-gray-800/50"
    >
      Wähle einen Markt, um geschätzte Preise anzuzeigen.
    </div>
  </div>
</section>

<script is:inline define:vars={{ productData: products }}>
  (function() {
    const panel = document.getElementById('shopping-market-panel');
    if (!panel) return;
    const select = document.getElementById('shopping-market-select');
    const summary = document.getElementById('shopping-market-summary');
    const listId = panel.dataset.listId;
    if (!select || !summary || !listId) return;

    const productMap = new Map();
    for (const p of productData) productMap.set(p.id, p);

    function priceForProduct(product, supermarketId) {
      if (!product) return null;
      if (supermarketId) {
        const entry = (product.supermarkets || []).find(s => s.supermarketId === supermarketId);
        if (entry && entry.price != null) return entry.price;
      }
      if (product.defaultPrice != null) return product.defaultPrice;
      return null;
    }

    function grams(item) {
      const qty = Number(item?.quantity) || 0;
      if (!qty) return null;
      const unit = String(item?.unit || '').toLowerCase();
      if (unit === 'g') return qty;
      if (unit === 'kg') return qty * 1000;
      if (unit === 'mg') return qty / 1000;
      return null;
    }

    function formatEuro(value) {
      if (value == null || !Number.isFinite(value)) return '–';
      return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(value);
    }

    async function loadList() {
      const res = await fetch(`/api/shopping-lists?id=${encodeURIComponent(listId)}`);
      if (!res.ok) return null;
      return await res.json();
    }

    async function recompute() {
      const supermarketId = select.value || null;
      const list = await loadList();
      if (!list) {
        summary.textContent = 'Liste konnte nicht geladen werden.';
        return;
      }
      const items = Array.isArray(list.items) ? list.items : [];
      let total = 0;
      let priced = 0;
      let unpriced = 0;
      for (const item of items) {
        const productId = item.productId;
        if (!productId) { unpriced++; continue; }
        const product = productMap.get(productId);
        const perUnit = priceForProduct(product, supermarketId);
        if (perUnit == null) { unpriced++; continue; }
        const g = grams(item);
        if (g != null && product && Number(product.netGrams) > 0) {
          total += (g / Number(product.netGrams)) * perUnit;
          priced++;
        } else {
          // Fallback: one package per item
          total += perUnit;
          priced++;
        }
      }
      const marketName = select.options[select.selectedIndex]?.text || '';
      const details = `Geschätzte Summe (${marketName || 'ohne Markt'}): <strong>${formatEuro(total)}</strong>` +
        ` · ${priced} Positionen mit Preis, ${unpriced} ohne.`;
      summary.innerHTML = details;
    }

    async function persistSelection() {
      const supermarketId = select.value || null;
      try {
        await fetch(`/api/shopping-lists?id=${encodeURIComponent(listId)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ preferredSupermarketId: supermarketId }),
        });
      } catch (err) {
        console.error('Failed to persist supermarket preference', err);
      }
    }

    select.addEventListener('change', async () => {
      await persistSelection();
      await recompute();
    });

    recompute();
  })();
</script>
