---
import type { NutritionData } from '../../../types/recipe';
import { NUTRITION_FIELDS, hasNutritionValues } from '../../../lib/nutrition';

interface Props {
  nutrition: NutritionData;
  /** When true, prepend "~" to values to signal the total is estimated. */
  isEstimated?: boolean;
  /**
   * Optional source label ("berechnet" vs "Rezeptangabe"), shown above the
   * card as a small hint so users can distinguish live-calculated values
   * from manually entered metadata.
   */
  sourceLabel?: string;
}

const { nutrition, isEstimated = false, sourceLabel } = Astro.props;
const primaryFields = NUTRITION_FIELDS.filter((field) => field.group === 'primary');
const detailFields = NUTRITION_FIELDS.filter((field) => field.group === 'detail');
const hasPrimaryAssessment = primaryFields.some((field) => nutrition[field.key] != null);

function assessCalories(calories: number): { symbol: string; color: string; title: string } {
  if (calories < 200) return { symbol: '⬇️', color: 'text-blue-500', title: 'Niedrig' };
  if (calories <= 500) return { symbol: '✅', color: 'text-green-500', title: 'Optimal' };
  if (calories <= 700) return { symbol: '⚠️', color: 'text-yellow-500', title: 'Hoch' };
  return { symbol: '⬆️', color: 'text-red-500', title: 'Sehr hoch' };
}

function assessCarbohydrates(carbs: number): { symbol: string; color: string; title: string } {
  if (carbs < 20) return { symbol: '⬇️', color: 'text-blue-500', title: 'Niedrig' };
  if (carbs <= 60) return { symbol: '✅', color: 'text-green-500', title: 'Optimal' };
  if (carbs <= 80) return { symbol: '⚠️', color: 'text-yellow-500', title: 'Hoch' };
  return { symbol: '⬆️', color: 'text-red-500', title: 'Sehr hoch' };
}

function assessProtein(protein: number): { symbol: string; color: string; title: string } {
  if (protein < 10) return { symbol: '⬇️', color: 'text-blue-500', title: 'Niedrig' };
  if (protein <= 35) return { symbol: '✅', color: 'text-green-500', title: 'Optimal' };
  if (protein <= 50) return { symbol: '⚠️', color: 'text-yellow-500', title: 'Hoch' };
  return { symbol: '⬆️', color: 'text-red-500', title: 'Sehr hoch' };
}

function assessFat(fat: number): { symbol: string; color: string; title: string } {
  if (fat < 5) return { symbol: '⬇️', color: 'text-blue-500', title: 'Niedrig' };
  if (fat <= 25) return { symbol: '✅', color: 'text-green-500', title: 'Optimal' };
  if (fat <= 35) return { symbol: '⚠️', color: 'text-yellow-500', title: 'Hoch' };
  return { symbol: '⬆️', color: 'text-red-500', title: 'Sehr hoch' };
}

function assessPrimary(key: string, value: number) {
  if (key === 'calories') return assessCalories(value);
  if (key === 'carbohydrates') return assessCarbohydrates(value);
  if (key === 'protein') return assessProtein(value);
  if (key === 'fat') return assessFat(value);
  return null;
}

function formatValue(key: string, value: number, unit: string) {
  const rounded = key === 'calories' ? Math.round(value) : Math.round(value * 10) / 10;
  const prefix = isEstimated ? '~' : '';
  return key === 'calories' ? `${prefix}${rounded}` : `${prefix}${rounded}${unit}`;
}
---

{hasNutritionValues(nutrition) && (
  <div class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg border border-green-200 dark:border-green-700 p-4 mb-4">
    <h3 class="text-lg font-semibold text-green-800 dark:text-green-200 mb-3 flex items-center justify-between flex-wrap gap-2">
      <span class="flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        Nährwerte pro Portion
        {isEstimated && (
          <span class="ml-2 text-xs font-normal text-yellow-700 dark:text-yellow-300" title="mind. eine Zutat geschätzt">~ geschätzt</span>
        )}
      </span>
      {sourceLabel && (
        <span class="text-xs font-normal text-gray-600 dark:text-gray-300">{sourceLabel}</span>
      )}
    </h3>
    
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {primaryFields.map((field) => {
        const value = nutrition[field.key];
        if (value == null) return null;
        const assessment = assessPrimary(field.key, value);
        return (
          <div class="text-center">
            <div class="flex items-center justify-center mb-1">
              <div class={`text-2xl font-bold ${field.valueClass} mr-2`}>
                {formatValue(field.key, value, field.unit)}
              </div>
              {assessment && (
                <span class={`text-lg ${assessment.color}`} title={assessment.title}>
                  {assessment.symbol}
                </span>
              )}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">{field.label}</div>
          </div>
        );
      })}
    </div>

    {detailFields.some((field) => nutrition[field.key] != null) && (
      <div class="mt-4 pt-3 border-t border-green-200 dark:border-green-700 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {detailFields.map((field) => {
          const value = nutrition[field.key];
          if (value == null) return null;
          const rounded = Math.round(value * 100) / 100;
          return (
            <div class="text-center">
              <div class={`text-lg font-semibold ${field.valueClass}`}>
                {isEstimated ? '~' : ''}{rounded}{field.unit}
              </div>
              <div class="text-xs text-gray-600 dark:text-gray-400">{field.label}</div>
            </div>
          );
        })}
      </div>
    )}

    {hasPrimaryAssessment && (
      <div class="mt-4 pt-3 border-t border-green-200 dark:border-green-700">
        <div class="text-xs text-gray-500 dark:text-gray-400 flex flex-wrap justify-center gap-4">
          <span class="flex items-center">
            <span class="text-blue-500 mr-1">⬇️</span> Niedrig
          </span>
          <span class="flex items-center">
            <span class="text-green-500 mr-1">✅</span> Optimal
          </span>
          <span class="flex items-center">
            <span class="text-yellow-500 mr-1">⚠️</span> Hoch
          </span>
          <span class="flex items-center">
            <span class="text-red-500 mr-1">⬆️</span> Sehr hoch
          </span>
        </div>
      </div>
    )}
  </div>
)}
